<?xml version="1.0"?>
<robot name="stereo_robot">
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry><box size="0.8 0.5 0.2"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.8 0.5 0.2"/></geometry>
    </collision>
  </link>

  <!-- Left Camera Block -->
  <link name="left_camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <joint name="left_camera_joint" type="fixed">
    <parent link="base_link"/><child link="left_camera_link"/>
    <origin xyz="0.4 0.1 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Right Camera Block -->
  <link name="right_camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <joint name="right_camera_joint" type="fixed">
    <parent link="base_link"/><child link="right_camera_link"/>
    <origin xyz="0.4 -0.1 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <link name="fl_wheel"><visual><geometry><cylinder length="0.1" radius="0.15"/></geometry></visual><collision><geometry><cylinder length="0.1" radius="0.15"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="fl_joint" type="continuous"><parent link="base_link"/><child link="fl_wheel"/><origin xyz="0.3 0.3 -0.05" rpy="1.5708 0 0"/><axis xyz="0 0 -1"/></joint>
  
  <link name="fr_wheel"><visual><geometry><cylinder length="0.1" radius="0.15"/></geometry></visual><collision><geometry><cylinder length="0.1" radius="0.15"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="fr_joint" type="continuous"><parent link="base_link"/><child link="fr_wheel"/><origin xyz="0.3 -0.3 -0.05" rpy="1.5708 0 0"/><axis xyz="0 0 -1"/></joint>

  <link name="rl_wheel"><visual><geometry><cylinder length="0.1" radius="0.15"/></geometry></visual><collision><geometry><cylinder length="0.1" radius="0.15"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="rl_joint" type="continuous"><parent link="base_link"/><child link="rl_wheel"/><origin xyz="-0.3 0.3 -0.05" rpy="1.5708 0 0"/><axis xyz="0 0 -1"/></joint>

  <link name="rr_wheel"><visual><geometry><cylinder length="0.1" radius="0.15"/></geometry></visual><collision><geometry><cylinder length="0.1" radius="0.15"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="rr_joint" type="continuous"><parent link="base_link"/><child link="rr_wheel"/><origin xyz="-0.3 -0.3 -0.05" rpy="1.5708 0 0"/><axis xyz="0 0 -1"/></joint>
</robot>
